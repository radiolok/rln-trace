# rln-trace: доступ без root (sudo cp sw/udev/50-rln-trace.rules /etc/udev/rules.d/)
# Загрузчик WCH ISP: CH569, CH32H417 и др. (wchisp)
SUBSYSTEM=="usb", ATTRS{idVendor}=="4348", ATTRS{idProduct}=="55e0", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55e0", MODE="0666"
# fw/ch569/usbstream (VID:PID HydraUSB3 по умолчанию, общий для libusb-устройств V-USB)
SUBSYSTEM=="usb", ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="05dc", MODE="0666"
