(rectangle (start 12.7 180.34) (end 406.4 254.0) (stroke (width 0.254) (type dash) (color 120 120 120 1)) (fill (type none)) (uuid "4b949f7d-f50d-56bc-9ce4-23b499840eca"))
(text "MIPI20 (RISC-V Trace Connectors 1.0 = Cortex Debug+ETM)" (exclude_from_sim no) (at 13.97 15.24 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "4a70486c-f2f6-5f9b-9182-afefe2466881"))
(text "Level translation (VREF 1.2..3.6 V), nRESET" (exclude_from_sim no) (at 163.83 15.24 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "86a09bd2-352c-57a0-80a2-2b593a813972"))
(text "Target power (pins 11/13), measurement" (exclude_from_sim no) (at 13.97 182.88 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "3471c1ab-f185-578d-ba9c-717e0c7d3140"))
(text "Pin 1 VREF, 2 TMS/SWDIO, 4 TCK/SWCLK, 6 TDO/SWO, 8 TDI, 10 nRESET,\n12 TRC_CLK, 14/16/18/20 TRC_DATA[0..3], 9 GNDDetect = GND on probe,\n11/13 GND or TgtPwr+Cap (JP1), 7 = KEY: remove pin 7 from the header\n(keyed Cortex Debug+ETM cables have hole 7 plugged). Shrouded keyed header." (exclude_from_sim no) (at 20.32 86.36 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cf0e1e16-47ed-5013-819f-5b08ac4c7757"))
(text "ESD array at the connector, then series R (33 Ohm, tune on prototype)." (exclude_from_sim no) (at 20.32 144.78 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c4804c08-3d43-5e6e-aecc-b04fe7870ac9"))
(text "Default after power-up: both translators disabled (OE pulled high),\nSWDIO direction = target->FPGA. Firmware enables OE only when\nVREF is within 1.2..3.6 V (ADS1115 AIN0).\nAVC: Ioff + VCC isolation -> Hi-Z when VREF = 0.\nTRC_DATA[2] as TRIGIN output is not supported in rev 0.1." (exclude_from_sim no) (at 259.08 83.82 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "35a7b8cd-23ca-52aa-8c18-10d9edc818d0"))
(text "nRESET: open drain (2N7002), state read back via U(AVC8) B7." (exclude_from_sim no) (at 312.42 162.56 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "13b94e20-a4fe-5c1f-b5e8-23fcf8e98fd7"))
(text "JP1 default 1-2 (pins 11/13 = GND).\nTgtPwr: 5 V, current-limited by AP2161 (FLG -> CH569),\ncurrent via INA219 (0x40), 10p at the pins per spec." (exclude_from_sim no) (at 190.5 238.76 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6f5f8366-a593-5339-a0ad-84dcaeecf19b"))
(text "ADS1115 @0x48:\nAIN0 VREF/2, AIN1 TgtPwr/2,\nAIN2 5V/2, AIN3 3V3/2" (exclude_from_sim no) (at 345.44 220.98 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "787a97ee-82cd-59e3-b7f9-20eaf3be1a63"))
