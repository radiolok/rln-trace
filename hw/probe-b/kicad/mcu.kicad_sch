(text "CH569W: USB3 SS device, HSPI 16 bit to FPGA" (exclude_from_sim no) (at 13.97 15.24 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "d78eca12-a3ff-561b-a6d6-4e1c9bed98cf"))
(text "Power decoupling (per WCH CH569W-R0 reference)" (exclude_from_sim no) (at 207.01 15.24 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "b92f9012-4d38-55d8-86bd-37b4a49438de"))
(text "Clock, boot, UART, FPGA-flash access, I2C, expansion" (exclude_from_sim no) (at 207.01 128.27 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "f3c5316b-7258-57ec-baf2-f8f5cad94630"))
(text "PB15 = HD14 is also RST#: disable the RST# function in the CH569 config\n(WCH ISP tool) before the FPGA drives HSPI_D14. 10k pull-up keeps it inactive.\nHD0 low at power-up = USB ISP bootloader (BOOT button)." (exclude_from_sim no) (at 20.32 241.3 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a3ee6067-1022-5f53-86d9-6833f9c56baf"))
(text "VDDIO x3, V33LDO, V33GX, V33USB: 100n each + 3.3u at V33LDO" (exclude_from_sim no) (at 297.18 45.72 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "56e6c058-145a-54fd-b47d-27bccb08ff5b"))
(text "+1V2_CH = internal LDO output (V12CORE pin 63):\n100n at pins 9, 63, 6 + 3.3u at pin 63. Do not load externally." (exclude_from_sim no) (at 297.18 78.74 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cd107203-550f-5090-bf50-5156f402a55b"))
(text "UART1: 1 GND, 2 TX (out), 3 RX (in), 4 3V3" (exclude_from_sim no) (at 340.36 160.02 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ec89c4d4-1550-54bb-8f1d-9e883df6f23b"))
(text "CH569 SPI0 -> FPGA config flash (update path).\nCH569 drives only while FPGA_RECONFIG_N = 0;\notherwise SPI0 pins stay inputs (Hi-Z)." (exclude_from_sim no) (at 213.36 236.22 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3fd1d3af-e74d-5363-a2e7-f79552689cf8"))
(text "EXP: spare FPGA + CH569 GPIO (debug, test)" (exclude_from_sim no) (at 342.9 228.6 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a756f1b0-0fa9-5aaf-839f-41658156df1b"))
