// Tang Nano 9K (GW1NR-LV9QN88PC6/I5) on the bench: top_jtag.sv, JTAG probe for
// the STM32F4-Discovery. Pins: 3.3 V header J5, away from the top_gen trace pins
// 25..33, so both wirings can stay on the board. Wiring: README.md.

IO_LOC "clk27" 52;
IO_PORT "clk27" IO_TYPE=LVCMOS33;
IO_LOC "s1_n" 4;
IO_PORT "s1_n" IO_TYPE=LVCMOS18;

IO_LOC "led_n[0]" 10;
IO_LOC "led_n[1]" 11;
IO_LOC "led_n[2]" 13;
IO_LOC "led_n[3]" 14;
IO_LOC "led_n[4]" 15;
IO_LOC "led_n[5]" 16;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS18;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS18;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS18;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS18;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS18;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS18;

// BL702 USB-UART
IO_LOC "uart_txd" 17;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33;
IO_LOC "uart_rxd" 18;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// to the STM32F4-Discovery, header J5 (3.3 V)
IO_LOC "jtck" 34;
IO_LOC "jtms" 40;
IO_LOC "jtdi" 35;
IO_LOC "jtdo" 41;
IO_LOC "jsrst_n" 42;
IO_LOC "jtrst_n" 39;
IO_PORT "jtck" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "jtms" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "jtdi" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "jtdo" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "jsrst_n" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;
IO_PORT "jtrst_n" IO_TYPE=LVCMOS33 DRIVE=8;
