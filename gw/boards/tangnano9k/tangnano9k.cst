// Tang Nano 9K (GW1NR-LV9QN88PC6/I5) on the bench: top_gen.sv.
// Header pins from the Sipeed schematic Tang_nano_9K_3674 (J5, J6); on-board
// parts from the Sipeed examples. Header pins 79..86 sit in a 1.8 V bank: not
// used. Wiring to the Tang Nano 20K: README.md.

IO_LOC "clk27" 52;
IO_PORT "clk27" IO_TYPE=LVCMOS33;
IO_LOC "s1_n" 4;
IO_PORT "s1_n" IO_TYPE=LVCMOS18;
IO_LOC "s2_n" 3;
IO_PORT "s2_n" IO_TYPE=LVCMOS18;

IO_LOC "led_n[0]" 10;
IO_LOC "led_n[1]" 11;
IO_LOC "led_n[2]" 13;
IO_LOC "led_n[3]" 14;
IO_LOC "led_n[4]" 15;
IO_LOC "led_n[5]" 16;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS18;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS18;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS18;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS18;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS18;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS18;

// BL702 USB-UART
IO_LOC "uart_txd" 17;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33;

// to the Tang Nano 20K, header J5 (3.3 V)
IO_LOC "traceclk" 25;
IO_LOC "traced[0]" 26;
IO_LOC "traced[1]" 27;
IO_LOC "traced[2]" 28;
IO_LOC "traced[3]" 29;
IO_LOC "pps" 30;
IO_LOC "sq" 33;
IO_PORT "traceclk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "traced[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "traced[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "traced[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "traced[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "pps" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "sq" IO_TYPE=LVCMOS33 DRIVE=8;
