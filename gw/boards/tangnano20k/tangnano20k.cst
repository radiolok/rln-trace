// Tang Nano 20K (GW2AR-LV18QN88C8/I7), bench step 0: top_step0.sv.
// Board pins from the Sipeed pin label (wiki.sipeed.com, tang_nano_20k_pinlabel.png),
// on-board parts from the Sipeed examples. Header table: README.md.

IO_LOC "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33;
IO_LOC "s1" 88;
IO_PORT "s1" IO_TYPE=LVCMOS33;
IO_LOC "s2" 87;
IO_PORT "s2" IO_TYPE=LVCMOS33;

IO_LOC "led_n[0]" 15;
IO_LOC "led_n[1]" 16;
IO_LOC "led_n[2]" 17;
IO_LOC "led_n[3]" 18;
IO_LOC "led_n[4]" 19;
IO_LOC "led_n[5]" 20;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 DRIVE=8;

// BL616 USB-UART
IO_LOC "uart_txd" 69;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33;

// HSPI data, right header: bank 3, pull-up (HD0 low at CH569 power-on means its boot loader)
IO_LOC "hd[0]" 56;
IO_LOC "hd[1]" 54;
IO_LOC "hd[2]" 51;
IO_LOC "hd[3]" 48;
IO_LOC "hd[4]" 55;
IO_LOC "hd[5]" 49;
IO_LOC "hd[6]" 53;
IO_LOC "hd[7]" 52;
IO_PORT "hd[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// FPGA -> CH569
IO_LOC "hrclk" 80;
IO_LOC "hract" 86;
IO_LOC "hrvld" 72;
IO_LOC "htack" 71;
IO_PORT "hrclk" IO_TYPE=LVCMOS33 DRIVE=12;
IO_PORT "hract" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hrvld" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "htack" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// CH569 -> FPGA; HTCLK on the only single-ended global clock pin of the headers (GCLKT_1)
IO_LOC "htclk" 77;
IO_LOC "htreq" 73;
IO_LOC "htvld" 74;
IO_LOC "htrdy" 75;
IO_PORT "htclk" IO_TYPE=LVCMOS33;
IO_PORT "htreq" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "htvld" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "htrdy" IO_TYPE=LVCMOS33 DRIVE=8;
