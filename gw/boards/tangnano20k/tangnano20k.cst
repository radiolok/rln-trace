// Tang Nano 20K (GW2AR-LV18QN88C8/I7) on the bench, pin plan v2: HSPI 16 bit.
// The LED resistors are removed, so pins 15-20 are plain IO. Header pins from the
// Sipeed pin label (wiki.sipeed.com, tang_nano_20k_pinlabel.png). Every one of the
// 34 header pins is spoken for; the table and the CH569 EVT wiring: README.md.
// Lines starting with "//>" are the pins of later steps, not used by top_step0.

IO_LOC "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33;
IO_LOC "s1" 88;
IO_PORT "s1" IO_TYPE=LVCMOS33;
IO_LOC "s2" 87;
IO_PORT "s2" IO_TYPE=LVCMOS33;

// BL616 USB-UART (not on the headers)
IO_LOC "uart_txd" 69;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33;

// HSPI data. Pull-up: HD0 low at CH569 power-on means its boot loader.
// 79 also drives the on-board WS2812, 80 and 85 go to the SD slot (keep it empty),
// 51/54/55/56 to the audio amplifier, 41/42/48/49 to the LCD connector: loads only.
IO_LOC "hd[0]" 80;
IO_LOC "hd[1]" 42;
IO_LOC "hd[2]" 41;
IO_LOC "hd[3]" 56;
IO_LOC "hd[4]" 54;
IO_LOC "hd[5]" 51;
IO_LOC "hd[6]" 48;
IO_LOC "hd[7]" 55;
IO_LOC "hd[8]" 49;
IO_LOC "hd[9]" 86;
IO_LOC "hd[10]" 79;
IO_LOC "hd[11]" 72;
IO_LOC "hd[12]" 71;
IO_LOC "hd[13]" 53;
IO_LOC "hd[14]" 52;
IO_LOC "hd[15]" 30;
IO_PORT "hd[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[8]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[9]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[10]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[11]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[12]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[13]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[14]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "hd[15]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// FPGA -> CH569
IO_LOC "hrclk" 73;
IO_LOC "hract" 74;
IO_LOC "hrvld" 75;
IO_LOC "htack" 85;
IO_PORT "hrclk" IO_TYPE=LVCMOS33 DRIVE=12;
IO_PORT "hract" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hrvld" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "htack" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// CH569 -> FPGA. HTCLK on GCLKC_1: the only true global clock pin of the
// headers (77, GCLKT_1) belongs to TRACECLK.
IO_LOC "htclk" 76;
IO_LOC "htreq" 25;
IO_LOC "htvld" 26;
IO_LOC "htrdy" 29;
IO_PORT "htclk" IO_TYPE=LVCMOS33;
IO_PORT "htreq" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "htvld" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "htrdy" IO_TYPE=LVCMOS33 DRIVE=8;

//> trace (step 1+): TRACECLK 77 (GCLKT_1), TRACED0..3 15, 16, 27, 28
//> events: PPS 31, SMA2 17
//> SWD (step 6): SWDIO 20, SWCLK 19, nRESET 18
//> JTAG (step 7) needs TDI, TDO, nTRST on top: HSPI back to 8 bit frees hd[8..15]
