// uprobe: 22 свободных GPIO GW5AT-15 MG132 без каналов CH0..CH15 (MBGA132.json Gowin EDA).
// Не тронуты: JTAG G2 G3 J3 J2, RECONFIG_N M3, DONE L3, READY M12, MODE1/0 N1 N2, флеш L13 L14 M13
// K14 K13 M14. LVCMOS33 (банки 1, 3, 4 — 3,3 В), без подтяжек, DRIVE=4 — слабый выход на случай,
// если на той же цепи чей-то выход. Порядок p[i] берёт uprobe.py.

IO_LOC "p[0]" C13;  // IOB36B банк 1
IO_PORT "p[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[1]" D13;  // IOB36A банк 1
IO_PORT "p[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[2]" C14;  // IOB39B банк 1 D10
IO_PORT "p[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[3]" D14;  // IOB39A банк 1 D11
IO_PORT "p[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[4]" E13;  // IOB34B банк 1 GCLKC_0
IO_PORT "p[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[5]" F13;  // IOB34A банк 1 GCLKT_0
IO_PORT "p[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[6]" E14;  // IOB43B банк 1 D08
IO_PORT "p[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[7]" F14;  // IOB43A банк 1 D09
IO_PORT "p[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[8]" G13;  // IOB32B банк 1 GCLKC_1
IO_PORT "p[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[9]" H13;  // IOB32A банк 1 GCLKT_1
IO_PORT "p[9]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[10]" G14;  // IOB45B банк 1 EMCCLK
IO_PORT "p[10]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[11]" H14;  // IOB45A банк 1
IO_PORT "p[11]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[12]" J12;  // IOB31A банк 1
IO_PORT "p[12]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[13]" M8;  // IOB11A банк 1
IO_PORT "p[13]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[14]" H2;  // IOL22B банк 4 SO
IO_PORT "p[14]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[15]" H3;  // IOL22A банк 4 SSPI_CLK
IO_PORT "p[15]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[16]" K2;  // IOL26B банк 4 D07
IO_PORT "p[16]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[17]" K3;  // IOL26A банк 4 D06
IO_PORT "p[17]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[18]" M1;  // IOL33B банк 3 SDA
IO_PORT "p[18]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[19]" M2;  // IOL33A банк 3 SCL
IO_PORT "p[19]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[20]" P1;  // IOL35B банк 3 D05/SSPI_CS_N
IO_PORT "p[20]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "p[21]" P2;  // IOL35A банк 3 D04/SI
IO_PORT "p[21]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
