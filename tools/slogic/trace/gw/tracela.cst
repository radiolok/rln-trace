// Sipeed SLogic16U3, GW5AT-LV15MG132C1/I0: header inputs CH0..CH15 (bank 1, VCCIO 3.3 V).
// LVCMOS15UD33: ~0.75 V threshold on a 3.3 V bank - the input dividers give ~1.42 V from 3.0 V,
// below the LVCMOS33 threshold. No pulls: the front end has its own bias. See top.sv.

IO_LOC "ch[0]" J14;  // IOB41B
IO_PORT "ch[0]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[1]" J13;  // IOB41A
IO_PORT "ch[1]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[2]" N14;  // IOB12B
IO_PORT "ch[2]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[3]" P14;  // IOB12A
IO_PORT "ch[3]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[4]" N13;  // IOB14B
IO_PORT "ch[4]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[5]" P13;  // IOB14A
IO_PORT "ch[5]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[6]" N12;  // IOB16A
IO_PORT "ch[6]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[7]" P12;  // IOB16B
IO_PORT "ch[7]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[8]" N11;  // IOB22A
IO_PORT "ch[8]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[9]" P11;  // IOB22B
IO_PORT "ch[9]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[10]" N10;  // IOB18B
IO_PORT "ch[10]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[11]" P10;  // IOB18A
IO_PORT "ch[11]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[12]" N9;  // IOB24A
IO_PORT "ch[12]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[13]" P9;  // IOB24B
IO_PORT "ch[13]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[14]" N8;  // IOB20A
IO_PORT "ch[14]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[15]" P8;  // IOB20B
IO_PORT "ch[15]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
