// Прозвонка SLogic16U3: все свободные выводы GW5AT-15 CS130 — входы p[i].
// Не заняты: JTAG (E7 E8 H7 H8), RECONFIG_N K6 (кнопка MODE), DONE K7, READY K5,
// MODE0/1 H6 G6. G5/J4 (D02/D03) — IO2/IO3 флеш, если она в quad: только вход с подтяжкой.
// pinmap.py берёт отсюда соответствие p[i] — шарик.

IO_LOC "p[0]" D2;
IO_PORT "p[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "p[1]" D3;
IO_PORT "p[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "p[2]" D4;
IO_PORT "p[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "p[3]" E1;
IO_PORT "p[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "p[4]" E2;
IO_PORT "p[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "p[5]" E3;
IO_PORT "p[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "p[6]" E4;
IO_PORT "p[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
