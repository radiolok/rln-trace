// MSPI к флеш
IO_LOC "f_cs_n" H4;  // MCS_N
IO_PORT "f_cs_n" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "f_sck" H5;  // CCLK
IO_PORT "f_sck" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "f_mosi" K4;  // MOSI
IO_PORT "f_mosi" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "f_miso" G4;  // MISO
IO_PORT "f_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
