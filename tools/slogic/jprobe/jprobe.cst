// Прозвонка SLogic16U3 по JTAG: кандидаты GW5AT-15 MG132 (MBGA132.json Gowin EDA) — только входы
// без подтяжки. Не тронуты: JTAG G2 G3 J3 J2, RECONFIG_N M3, DONE L3, READY M12, MODE1/0 N1 N2,
// флеш L13 L14 M13 K14 (MCS_N CCLK MOSI MISO), K13 M14 (D02/D03 = IO2/IO3).
// LVCMOS15UD33 — порог ~0,75 В на банке 3,3 В: входные делители прибора дают из 3 В ~1,42 В, порог
// LVCMOS33 выше. K3 K2 (банк 4) не влезли в лимит I/O — во второй проход. Порядок p[i] берёт jprobe.py.

IO_LOC "p[0]" M8;  // IOB11A банк 1
IO_PORT "p[0]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[1]" P14;  // IOB12A банк 1
IO_PORT "p[1]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[2]" N14;  // IOB12B банк 1
IO_PORT "p[2]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[3]" P13;  // IOB14A банк 1 D15
IO_PORT "p[3]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[4]" N13;  // IOB14B банк 1 D14
IO_PORT "p[4]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[5]" N12;  // IOB16A банк 1
IO_PORT "p[5]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[6]" P12;  // IOB16B банк 1
IO_PORT "p[6]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[7]" P10;  // IOB18A банк 1 D13
IO_PORT "p[7]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[8]" N10;  // IOB18B банк 1 D12
IO_PORT "p[8]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[9]" N8;  // IOB20A банк 1
IO_PORT "p[9]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[10]" P8;  // IOB20B банк 1
IO_PORT "p[10]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[11]" N11;  // IOB22A банк 1 GCLKT_3
IO_PORT "p[11]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[12]" P11;  // IOB22B банк 1 GCLKC_3
IO_PORT "p[12]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[13]" N9;  // IOB24A банк 1 GCLKT_2/BPLL_T_IN0/BPLL_T_FB1
IO_PORT "p[13]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[14]" P9;  // IOB24B банк 1 GCLKC_2/BPLL_C_IN0/BPLL_C_FB1
IO_PORT "p[14]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[15]" J12;  // IOB31A банк 1
IO_PORT "p[15]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[16]" H13;  // IOB32A банк 1 GCLKT_1/BPLL_T_IN1/BPLL_T_FB0
IO_PORT "p[16]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[17]" G13;  // IOB32B банк 1 GCLKC_1/BPLL_C_IN1/BPLL_C_FB0
IO_PORT "p[17]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[18]" F13;  // IOB34A банк 1 GCLKT_0
IO_PORT "p[18]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[19]" E13;  // IOB34B банк 1 GCLKC_0
IO_PORT "p[19]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[20]" D13;  // IOB36A банк 1
IO_PORT "p[20]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[21]" C13;  // IOB36B банк 1
IO_PORT "p[21]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[22]" D14;  // IOB39A банк 1 D11
IO_PORT "p[22]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[23]" C14;  // IOB39B банк 1 D10
IO_PORT "p[23]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[24]" J13;  // IOB41A банк 1
IO_PORT "p[24]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[25]" J14;  // IOB41B банк 1
IO_PORT "p[25]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[26]" F14;  // IOB43A банк 1 D09
IO_PORT "p[26]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[27]" E14;  // IOB43B банк 1 D08
IO_PORT "p[27]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[28]" H14;  // IOB45A банк 1
IO_PORT "p[28]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[29]" G14;  // IOB45B банк 1 EMCCLK
IO_PORT "p[29]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[30]" M2;  // IOL33A банк 3 GCLKT_4/LPLL_T_IN1/LPLL_T_FB0/CSO_B/DOUT/SCL
IO_PORT "p[30]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[31]" M1;  // IOL33B банк 3 GCLKC_4/LPLL_C_IN1/LPLL_C_FB0/CSI_B/SDA
IO_PORT "p[31]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[32]" P2;  // IOL35A банк 3 D04/SI/SSI0
IO_PORT "p[32]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[33]" P1;  // IOL35B банк 3 D05/SSPI_CS_N
IO_PORT "p[33]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[34]" H3;  // IOL22A банк 4 GCLKT_7/Q0REF_T_IN0/SSPI_CLK
IO_PORT "p[34]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "p[35]" H2;  // IOL22B банк 4 GCLKC_7/Q0REF_C_IN0/RDWR_B/SO/SSI1/PCIE_HOST_RSTN
IO_PORT "p[35]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;

